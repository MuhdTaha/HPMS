# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

# TypeScript & JavaScript
[*.{ts,js}]
quote_type = single
indent_size = 2

# Angular Templates (HTML)
[*.html]
indent_size = 2
# Prevents issues with long attribute lists in templates
max_line_length = 120

# Stylesheets
[*.{scss,css,less}]
indent_size = 2

# Components frequently use JSON for translations/configs
[*.json]
indent_size = 2

# Markdown
[*.md]
max_line_length = off
trim_trailing_whitespace = false

# Ensure specific config files stay clean
[Makefile]
indent_style = tab
